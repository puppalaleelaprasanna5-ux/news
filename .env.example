# Copy this file to ".env" and fill in real values.
# NEVER commit the actual ".env" file to Git. It is already listed in .gitignore.

# --- Application settings ---
APP_ENV=development

# --- Database ---
DATABASE_PATH=./data/app.db

# --- FastAPI backend ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- RAG evidence retrieval (used starting Phase 7) - all optional, defaults shown ---
# Local sentence-transformers model; downloaded once from the Hugging Face Hub, then cached.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Folder with your reference documents (.txt / .pdf) and folder where the FAISS index is saved
RAG_DOCS_DIR=./data/rag/reference_docs
RAG_INDEX_DIR=./data/rag/index
# For the demo with the synthetic sample documents use:  RAG_INDEX_DIR=./data/rag/demo_index
# (If RAG_INDEX_DIR is NOT set at all and data/rag/index does not exist but data/rag/demo_index does, the API uses the demo index.)
# Chunking (characters) and retrieval settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=5
# Minimum cosine similarity to return a passage (heuristic; tune on your own documents)
RAG_MIN_SCORE=0.35
# Set to 1 after the first download to forbid any network access by the model loader
# HF_HUB_OFFLINE=1

# --- Phase 8 dashboard (Streamlit -> FastAPI) ---
# Where the Streamlit page finds the API (default is built from BACKEND_HOST / BACKEND_PORT above)
# BACKEND_URL=http://127.0.0.1:8000
# Seconds the dashboard waits for /analyze (must exceed the model start-up time on the first request)
ANALYZE_TIMEOUT=300
