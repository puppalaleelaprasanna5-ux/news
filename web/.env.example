# NewsCred frontend environment variables.
# Copy this file to `.env` and adjust the values to match your FastAPI backend.

# Leave empty for same-origin production requests and local Vite proxying.
VITE_API_BASE_URL=

# Path of the analysis endpoint (POST).
VITE_API_ANALYZE_PATH=/analyze

# Path of the health endpoint (GET), used for clearer error messages.
VITE_API_HEALTH_PATH=/health

# Maximum article length accepted by the input UI (characters).
# Set this to the limit your backend actually enforces.
VITE_MAX_ARTICLE_LENGTH=20000
